
# .gitignore

# Build logs
build_logs/*
backup/*
tests/*

# Docker build artifacts
*.log

# Development session files (local development only)
.github/*
.vscode/*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*~
*.swp
*.swo
.idea/*

# Temporary files
*.tmp
*.bak

.gitattributes

